                "type": "datetime"
              },
              {
                "name": "onHoldDuration",
                "type": "int"
              },
              {
                "name": "feedbackMessage",
                "type": "dynamic"
              },
              {
                "name": "feedbackRating",
                "type": "dynamic"
              },
              {
                "name": "operator",
                "type": "dynamic"
              },
              {
                "name": "operatorGroup",
                "type": "dynamic"
              },
              {
                "name": "supplier",
                "type": "dynamic"
              },
              {
                "name": "processingStatus",
