            {
              "name": "responseDate",
              "type": "datetime"
            },
            {
              "name": "completed",
              "type": "boolean"
            },
            {
              "name": "completedDate",
              "type": "dynamic"
            },
            {
              "name": "closed",
              "type": "boolean"
            },
            {
              "name": "closedDate",
              "type": "dynamic"
            },
            {
              "name": "closureCode",
              "type": "dynamic"
            },
            {
              "name": "timeSpent",
              "type": "int"
            },
            {
              "name": "timeSpentFirstLine",
              "type": "int"
            },
            {
              "name": "timeSpentSecondLine",
              "type": "int"
            },
            {
              "name": "timeSpentPartial",
              "type": "int"
            },
            {
              "name": "timeSpentLinkedPartials",
              "type": "int"
            },
            {
              "name": "timeSpentSecondLineAndPartials",
              "type": "int"
            },
            {
              "name": "itemCosts",
              "type": "int"
            },
            {
              "name": "objectCosts",
              "type": "int"
            },
            {
              "name": "costs",
              "type": "int"
            },
            {
              "name": "escalationStatus",
              "type": "string"
            },
            {
              "name": "escalationReason",
              "type": "dynamic"
            },
            {
              "name": "escalationOperator",
              "type": "dynamic"
            },
            {
              "name": "callDate",
              "type": "datetime"
            },
            {
              "name": "creator",
              "type": "dynamic"
            },
            {
              "name": "creationDate",
              "type": "datetime"
            },
            {
              "name": "modifier",
              "type": "dynamic"
            },
            {
              "name": "modificationDate",
              "type": "datetime"
            },
            {
              "name": "majorCall",
              "type": "boolean"
            },
            {
              "name": "majorCallObject",
              "type": "dynamic"
            },
            {
              "name": "publishToSsd",
              "type": "boolean"
            },
            {
              "name": "monitored",
              "type": "boolean"
            },
            {
              "name": "expectedTimeSpent",
              "type": "int"
            },
            {
              "name": "archivingReason",
              "type": "dynamic"
            },
            {
              "name": "mainIncident",
              "type": "dynamic"
            },
            {
              "name": "optionalFields1",
              "type": "dynamic"
            },
            {
              "name": "optionalFields2",
              "type": "dynamic"
            },
            {
              "name": "externalLinks",
              "type": "dynamic"
            },
            {
              "name": "partialIncidents",
              "type": "dynamic"
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Insights/dataCollectionRules",
      "apiVersion": "2024-03-11",
      "name": "[parameters('dcrName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[variables('dceResourceId')]",
        "[resourceId('Microsoft.OperationalInsights/workspaces/tables', parameters('workspaceName'), parameters('tableName'))]"
      ],
      "properties": {
        "dataCollectionEndpointId": "[variables('dceResourceId')]",
        "description": "TOPdesk incidents CCF ingestion",
        "streamDeclarations": {
          "[parameters('streamName')]": {
            "columns": [
              {
                "name": "id",
                "type": "string"
              },
              {
                "name": "status",
                "type": "string"
              },
              {
                "name": "number",
