{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceName": { "type": "string" },
    "connectorDefinitionName": { "type": "string", "defaultValue": "TOPdeskIncidentsDefinition" },
    "dataConnectorName": { "type": "string", "defaultValue": "TOPdeskIncidents" },
    "publisher": { "type": "string", "defaultValue": "Jasper Minnaert - Wortell" },
    "topdeskBaseUrl": { "type": "string" },
    "username": { "type": "securestring" },
    "password": { "type": "securestring" },
    "dataCollectionEndpointUri": { "type": "string" },
    "dataCollectionRuleImmutableId": { "type": "string" },
    "streamName": { "type": "string", "defaultValue": "Custom-TOPdeskIncidents_CL" },
    "queryWindowInMin": { "type": "int", "defaultValue": 5 },
    "pageSize": { "type": "int", "defaultValue": 200 }
  },
  "variables": {
    "workspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]",
    "connectorDefinitionResourceId": "[concat(variables('workspaceResourceId'), '/providers/Microsoft.SecurityInsights/dataConnectorDefinitions/', parameters('connectorDefinitionName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.SecurityInsights/dataConnectorDefinitions",
      "apiVersion": "2025-09-01",
      "name": "[parameters('connectorDefinitionName')]",
      "scope": "[variables('workspaceResourceId')]",
      "properties": {
        "kind": "Customizable",
        "connectorUiConfig": {
          "title": "TOPdesk",
          "publisher": "[parameters('publisher')]",
          "descriptionMarkdown": "Ingest TOPdesk incidents using the Codeless Connector Platform (RestApiPoller).",
          "graphQueriesTableName": "TOPdeskIncidents_CL",
          "graphQueries": [
            {
              "metricName": "Events received",
              "legend": "TOPdesk incidents",
              "baseQuery": "{{graphQueriesTableName}}"
            }
          ],
          "sampleQueries": [
            {
              "description": "Latest TOPdesk incidents",
              "query": "{{graphQueriesTableName}}\n| sort by TimeGenerated desc\n| take 50"
            }
          ],
          "dataTypes": [
            {
              "name": "{{graphQueriesTableName}}",
              "lastDataReceivedQuery": "{{graphQueriesTableName}}\n| summarize Time=max(TimeGenerated)\n| where isnotempty(Time)"
            }
          ],
          "connectivityCriteria": [
            { "type": "HasDataConnectors" }
          ],
          "permissions": {
            "resourceProvider": [
              {
                "provider": "Microsoft.OperationalInsights/workspaces",
                "providerDisplayName": "Workspace",
                "scope": "Workspace",
                "permissionsDisplayText": "Read and Write permissions are required.",
                "requiredPermissions": { "read": true, "write": true, "delete": true }
              }
            ],
            "customs": [
              {
                "name": "TOPdesk API credentials",
                "description": "Operator username + application password"
              }
            ]
          },
          "instructionSteps": [
            {
              "title": "Connect TOPdesk",
              "description": "Provide the TOPdesk base URL and credentials.",
              "instructions": [
                {
                  "type": "Textbox",
                  "parameters": {
                    "name": "topdeskBaseUrl",
                    "label": "TOPdesk base URL (host only)",
                    "description": "Example: yourtenant.topdesk.net",
                    "placeholder": "yourtenant.topdesk.net",
                    "type": "text"
                  }
                },
                {
                  "type": "Textbox",
                  "parameters": {
                    "name": "username",
                    "label": "Username",
                    "placeholder": "operator@example.com",
                    "type": "text"
                  }
                },
                {
                  "type": "Textbox",
                  "parameters": {
                    "name": "password",
                    "label": "Application password",
                    "placeholder": "Application password",
                    "type": "password"
                  }
                }
              ]
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.SecurityInsights/dataConnectors",
      "apiVersion": "2025-09-01",
      "name": "[parameters('dataConnectorName')]",
      "scope": "[variables('workspaceResourceId')]",
      "kind": "RestApiPoller",
      "dependsOn": [
        "[variables('connectorDefinitionResourceId')]"
      ],
      "properties": {
        "connectorDefinitionName": "[parameters('connectorDefinitionName')]",
        "auth": {
          "type": "Basic",
          "UserName": "[parameters('username')]",
          "Password": "[parameters('password')]"
        },
        "request": {
          "apiEndpoint": "[format('https://{0}/tas/api/incidents', parameters('topdeskBaseUrl'))]",
          "httpMethod": "GET",
          "queryWindowInMin": "[parameters('queryWindowInMin')]",
          "timeoutInSeconds": 60,
          "retryCount": 3,
          "headers": {
            "Accept": "application/json"
          },
          "queryParameters": {
            "page_size": "[parameters('pageSize')]",
            "dateFormat": "iso8601"
          }
        },
        "paging": {
          "pagingType": "Offset",
          "offsetParaName": "start",
          "pageSize": "[parameters('pageSize')]",
          "pageSizeParameterName": "page_size",
          "pagingInfoPlacement": "QueryString"
        },
        "response": {
          "format": "json",
          "eventsJsonPaths": [ "$" ]
        },
        "dcrConfig": {
          "dataCollectionEndpoint": "[parameters('dataCollectionEndpointUri')]",
          "dataCollectionRuleImmutableId": "[parameters('dataCollectionRuleImmutableId')]",
          "streamName": "[parameters('streamName')]"
        }
      }
    }
  ]
}
