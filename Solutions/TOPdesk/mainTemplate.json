{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "workspaceName": {
      "type": "string"
    },
    "connectorDefinitionName": {
      "type": "string",
      "defaultValue": "TOPdeskIncidentsDefinition"
    },
    "dataConnectorName": {
      "type": "string",
      "defaultValue": "TOPdeskIncidents"
    },
    "publisher": {
      "type": "string",
      "defaultValue": "Wortell Enterprise Security"
    },
    "topdeskBaseUrl": {
      "type": "string"
    },
    "username": {
      "type": "securestring"
    },
    "password": {
      "type": "securestring"
    },
    "dceName": {
      "type": "string",
      "defaultValue": "dce-topdesk"
    },
    "dcrName": {
      "type": "string",
      "defaultValue": "dcr-topdesk-incidents"
    },
    "tableName": {
      "type": "string",
      "defaultValue": "TOPdeskIncidents_CL"
    },
    "streamName": {
      "type": "string",
      "defaultValue": "Custom-TOPdeskIncidents_CL"
    },
    "queryWindowInMin": {
      "type": "int",
      "defaultValue": 5
    },
    "pageSize": {
      "type": "int",
      "defaultValue": 200
    }
  },
  "variables": {
    "workspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]",
    "connectorDefinitionResourceId": "[concat(variables('workspaceResourceId'), '/providers/Microsoft.SecurityInsights/dataConnectorDefinitions/', parameters('connectorDefinitionName'))]",
