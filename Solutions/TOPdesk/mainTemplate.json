        "destinations": {
          "logAnalytics": [
            {
              "name": "laDest",
              "workspaceResourceId": "[variables('workspaceResourceId')]"
            }
          ]
        },
        "dataFlows": [
          {
            "streams": [
              "[parameters('streamName')]"
            ],
            "destinations": [
              "laDest"
            ],
            "transformKql": "source \n| extend TimeGenerated = todatetime(modificationDate)\n",
            "outputStream": "[concat('Custom-', parameters('tableName'))]"
          }
        ]
      }
    },
    {
      "type": "Microsoft.SecurityInsights/dataConnectorDefinitions",
      "apiVersion": "2025-09-01",
      "name": "[parameters('connectorDefinitionName')]",
      "scope": "[variables('workspaceResourceId')]",
      "properties": {
        "kind": "Customizable",
        "connectorUiConfig": {
          "id": "TOPdeskIncidentsDefinition",
          "title": "TOPdesk",
          "publisher": "[parameters('publisher')]",
          "descriptionMarkdown": "Ingest TOPdesk incidents using the Codeless Connector Framework (RestApiPoller).",
          "graphQueriesTableName": "[parameters('tableName')]",
          "graphQueries": [
            {
              "metricName": "Events received",
              "legend": "TOPdesk incidents",
              "baseQuery": "{{graphQueriesTableName}}"
            }
          ],
          "sampleQueries": [
            {
              "description": "Latest TOPdesk incidents",
              "query": "{{graphQueriesTableName}}\n| sort by TimeGenerated desc\n| take 50"
            }
          ],
          "dataTypes": [
            {
              "name": "{{graphQueriesTableName}}",
              "lastDataReceivedQuery": "{{graphQueriesTableName}}\n| summarize Time=max(TimeGenerated)\n| where isnotempty(Time)"
            }
          ],
          "connectivityCriteria": [
            {
              "type": "HasDataConnectors"
            }
          ],
          "permissions": {
            "resourceProvider": [
              {
                "provider": "Microsoft.OperationalInsights/workspaces",
                "providerDisplayName": "Workspace",
                "scope": "Workspace",
                "permissionsDisplayText": "Read and Write permissions are required.",
                "requiredPermissions": {
                  "read": true,
                  "write": true,
                  "delete": true
                }
              }
            ],
            "customs": [
              {
                "name": "TOPdesk API credentials",
                "description": "Operator username + application password"
              }
            ]
          },
          "instructionSteps": [
            {
              "title": "Connect TOPdesk",
              "description": "Provide the TOPdesk base URL and credentials.",
              "instructions": [
                {
                  "type": "Textbox",
                  "parameters": {
                    "name": "topdeskBaseUrl",
                    "label": "TOPdesk base URL (i.e. 'customer.topdesk.net')",
                    "description": "Example: 'customer.topdesk.net'",
                    "placeholder": "'customer.topdesk.net'",
                    "type": "text"
                  }
                },
                {
                  "type": "Textbox",
                  "parameters": {
                    "name": "username",
                    "label": "Username",
                    "placeholder": "operator@example.com",
                    "type": "text"
                  }
                },
                {
                  "type": "Textbox",
                  "parameters": {
                    "name": "password",
                    "label": "Application password",
                    "placeholder": "Application password",
                    "type": "securestring"
                  }
                },
                {
                  "parameters": {
                    "label": "toggle",
                    "name": "toggle"
                  },
                  "type": "ConnectionToggleButton"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.SecurityInsights/dataConnectors",
      "apiVersion": "2025-09-01",
      "name": "[parameters('dataConnectorName')]",
      "scope": "[variables('workspaceResourceId')]",
      "kind": "RestApiPoller",
      "dependsOn": [
        "[variables('connectorDefinitionResourceId')]",
        "[variables('dcrResourceId')]"
      ],
      "properties": {
        "connectorDefinitionName": "[parameters('connectorDefinitionName')]",
        "auth": {
          "type": "Basic",
          "UserName": "[parameters('username')]",
          "Password": "[parameters('password')]"
        },
        "request": {
          "apiEndpoint": "[format('https://{0}/tas/api/incidents', parameters('topdeskBaseUrl'))]",
          "httpMethod": "GET",
          "queryWindowInMin": "[parameters('queryWindowInMin')]",
          "timeoutInSeconds": 60,
          "retryCount": 3,
          "headers": {
            "Accept": "application/json"
          },
          "queryParameters": {
            "page_size": "[parameters('pageSize')]"
          },
          "queryTimeFormat": "yyyy-MM-ddTHH:mm:ssZ",
          "startTimeAttributeName": "modificationDate"
        },
        "paging": {
          "pagingType": "Offset",
          "offsetParaName": "start",
          "pageSize": "[parameters('pageSize')]",
          "pageSizeParameterName": "page_size",
          "pagingInfoPlacement": "QueryString"
        },
        "response": {
          "format": "json",
          "eventsJsonPaths": [
            "$"
          ]
        },
        "dcrConfig": {
          "dataCollectionEndpoint": "[reference(variables('dceResourceId'), '2024-03-11').properties.logsIngestion.endpoint]",
          "dataCollectionRuleImmutableId": "[reference(variables('dcrResourceId'), '2024-03-11').properties.immutableId]",
          "streamName": "[parameters('streamName')]"
        }
      }
    }
  ]
}