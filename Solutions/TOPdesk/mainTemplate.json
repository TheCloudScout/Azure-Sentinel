                "type": "dynamic"
              },
              {
                "name": "branch",
                "type": "dynamic"
              },
              {
                "name": "location",
                "type": "dynamic"
              },
              {
                "name": "impact",
                "type": "dynamic"
              },
              {
                "name": "urgency",
                "type": "dynamic"
              },
              {
                "name": "priority",
                "type": "dynamic"
              },
              {
                "name": "duration",
                "type": "dynamic"
              },
              {
                "name": "actualDuration",
                "type": "int"
              },
              {
                "name": "targetDate",
                "type": "datetime"
              },
              {
                "name": "sla",
                "type": "dynamic"
              },
              {
                "name": "onHold",
                "type": "boolean"
              },
              {
